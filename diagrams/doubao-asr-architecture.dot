digraph DoubaoASR {
  graph [
    rankdir=LR,
    bgcolor="#F8FAFC",
    fontname="PingFang SC",
    fontsize=28,
    fontcolor="#0F172A",
    labelloc=t,
    label="豆包输入法 1.1.2 离线语音模型架构\n专业版 LiteASRP_v1.2.0_7 (1.48 GB, FLUTE v3) · 通用版 LiteASRm_v1.0.1_5 (463 MB, FLUTE v2)",
    pad=0.4,
    nodesep=0.45,
    ranksep=0.65,
    splines=polyline,
    compound=true,
    dpi=160
  ];
  node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=18,
        color="#CBD5E1", fontcolor="#0F172A", fillcolor="#FFFFFF",
        penwidth=1.5, margin="0.20,0.16"];
  edge [color="#64748B", penwidth=1.8, arrowsize=0.8,
        fontname="PingFang SC", fontsize=14, fontcolor="#475569"];

  subgraph cluster_audio {
    label="音频输入与 VAD 分段（两版共用）";
    fontsize=21;
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#F1F5F9";
    audio [label="音频输入\n16 kHz PCM"];
    vad [label="VAD 端点检测\n84 维 Mel → vad_v4.pth.pthlite\n(Panther Lite · CPU)"];
    tail [label="TailVadProbeActor\n10 帧尾静音快检\n输出 tail_vad_state", fillcolor="#FEF3C7", color="#F59E0B"];
    split [label="WavSplitActor\n按 VAD 切分音频\n单段上限 18.5 s"];
    audio -> vad;
    vad -> tail [label="似然度"];
    vad -> split [label="语音区间"];
    audio -> split [label="原始音频", constraint=false];
  }

  subgraph cluster_stream {
    label="流式识别路径 · PantherLLMStreamContextActor";
    labeljust=l;
    fontsize=21;
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    sf [label="流式特征提取\n80 维 fbank + CMVN\n专业版 16 帧 / 通用版 32 帧", fillcolor="#DBEAFE", color="#60A5FA"];
    se [label="stream.packed (MNN)\n12 层流式解码器\n专业版: CPU · 通用版: Metal 编码 + CPU 解码", fillcolor="#DBEAFE", color="#60A5FA"];
    so [label="流式实时输出\nstream_context_output", fillcolor="#DCFCE7", color="#86EFAC"];
    sf -> se -> so;
  }

  subgraph cluster_context {
    label="非流式上下文路径 · PantherLLMNonStreamContextActor";
    labeljust=l;
    fontsize=21;
    color="#C4B5FD";
    style="rounded,filled";
    fillcolor="#F5F3FF";
    cf [label="独立非流式特征（仅专业版）\nnonstream_feature_extractor\n80 维 fbank + CMVN", fillcolor="#EDE9FE", color="#A78BFA"];
    ce [label="nonstream.packed / no_stream.packed (MNN)\n专业版: 独立权重, 29 层解码器 (Metal)\n通用版: share_weight=true, 共享骨干 (Metal)", fillcolor="#EDE9FE", color="#A78BFA"];
    prompt [label="PromptProcessor + rag_words\n对话历史 / 光标前后文 / 热词检索\nITN 数字规整 · 语气词标注 · 标点", fillcolor="#FFFFFF", color="#A78BFA"];
    co [label="最终上下文输出\nnon_s_context_result", fillcolor="#DCFCE7", color="#86EFAC"];
    cf -> ce [label="专业版 fbank"];
    prompt -> ce [label="文本提示与热词"];
    ce -> co;
  }

  split -> sf [label="分段音频"];
  split -> cf [label="专业版分段"];
  se -> ce [label="通用版复用 880 维 audio_proj\n(4× 下采样, share_weight=true)", style=dashed, color="#7C3AED", fontcolor="#6D28D9"];
}
